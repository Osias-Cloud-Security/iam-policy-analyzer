{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOnlyAudit",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances",
        "ec2:DescribeSecurityGroups",
        "iam:GetRole",
        "iam:ListRoles",
        "s3:ListAllMyBuckets",
        "s3:GetBucketLocation",
        "cloudtrail:LookupEvents"
      ],
      "Resource": "*"
    }
  ]
}
